      "id": "97437122-7b39-4ab7-864d-a67821f5f33f",
      "name": "Receives form data from Tally",
      "webhookId": "0fb2b910-cc17-406e-a300-1bc421b979cd"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst fields = data?.body?.data?.fields || \n               data?.body?.fields || \n               data?.fields || [];\n\nconst get = (label) => {\n  const field = fields.find(f => f.label === label);\n  if (!field) return \"\";\n  \n  // Handle dropdowns — map ID back to text\n  if (field.options && field.value) {\n    const ids = Array.isArray(field.value) ? field.value : [field.value];\n    const matched = field.options.filter(o => ids.includes(o.id));\n    return matched.map(o => o.text).join(\", \");\n  }\n  \n  return field.value || \"\";\n};\n\nreturn [{\n  json: {\n    name: get(\"Full Name\").trim(),\n    email: get(\"Email Address\").toLowerCase().trim(),\n    phone: get(\"Phone Number\").trim(),\n    zip: get(\"ZIP Code\").trim(),\n    serviceType: get(\"Service Type\"),\n    bedrooms: get(\"Number of Bedrooms\"),\n    bathrooms: get(\"Number of Bathrooms\"),\n    frequency: get(\"Cleaning Frequency\"),\n    preferredDate: get(\"Preferred Date\"),\n    specialInstructions: get(\"Special Instructions\"),\n    submittedAt: new Date().toISOString(),\n    leadSource: \"Website Form\",\n    status: \"NEW\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -272
      ],
      "id": "7cb60fbf-324a-4338-af95-a8c474212919",
      "name": "Cleans messy Tally data into readable fields"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst missing = [];\n\nif (!lead.name) missing.push(\"Name\");\nif (!lead.email || !lead.email.includes(\"@\")) missing.push(\"Email\");\nif (!lead.phone) missing.push(\"Phone\");\nif (!lead.zip || lead.zip.length < 5) missing.push(\"ZIP Code\");\nif (!lead.serviceType) missing.push(\"Service Type\");\nif (!lead.bedrooms) missing.push(\"Bedrooms\");\nif (!lead.bathrooms) missing.push(\"Bathrooms\");\nif (!lead.frequency) missing.push(\"Frequency\");\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      ...lead,\n      status: \"INVALID\",\n      reason: \"Missing fields: \" + missing.join(\", \")\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...lead,\n    status: \"VALID\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
